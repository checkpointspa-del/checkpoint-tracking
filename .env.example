# Copiare in .env per l'uso locale degli script.
# Su Vercel: Settings > Environment Variables. Nessun valore va committato.

# --- Shopify ---
# L'app ottiene da sola l'access token via Client Credentials Grant.
# Non esiste nessun token statico da inserire qui.
SHOPIFY_SHOP=checkpointspa.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=          # usato sia per l'OAuth sia per l'HMAC dei webhook
SHOPIFY_API_VERSION=2026-07

# --- App ---
APP_BASE_URL=https://checkpoint-tracking.vercel.app

# --- ShippyPro ---
SHIPPYPRO_API_KEY=              # serve solo al backfill iniziale
SHIPPYPRO_WEBHOOK_SECRET=       # stringa casuale, la stessa impostata come custom header su ShippyPro
SHIPPYPRO_ENDPOINT=https://www.shippypro.com/api
SHIPPYPRO_TRACK_METHOD=GetTracking

# ID dei canali ShippyPro che ci riguardano, separati da virgola.
# Sconsigliato: il MarketplaceID 3003 contiene spedizioni di più business.
# Ricavali con: npm run marketplaces. Vuoto = nessun filtro.
SHIPPYPRO_MARKETPLACE_IDS=

# Filtro consigliato: forma del numero d'ordine Shopify.
# Distingue i nostri eventi da quelli degli altri business che condividono
# l'account, senza interrogare Shopify. Il riferimento viene normalizzato
# prima del confronto: 26CKPT2661_1 e 26CKPT2661#2 diventano 26CKPT2661.
# Vuoto = nessun filtro.
SHOPIFY_ORDER_PATTERN=^\d{2}CKPT\d+$

# Alla creazione di un fulfillment, recupera da ShippyPro lo stato corrente.
# Chiude la finestra in cui gli eventi arrivano prima che Beestore abbia
# creato il fulfillment su Shopify. Richiede SHIPPYPRO_API_KEY anche su Vercel.
# 0 per disattivarlo.
SYNC_ON_CREATE=1

# --- Pagina tracking ---
TRACKING_TOKEN_SECRET=          # stringa casuale lunga: openssl rand -base64 32
TRACKING_PAGE_URL=https://www.check-point-store.it/pages/tracking-area
STOREFRONT_ORIGIN=https://www.check-point-store.it
SHOP_TIMEZONE=Europe/Rome

# --- Sicurezza ---
# 1 = simula tutto senza scrivere su Shopify. Tenere a 1 fino al via libera.
DRY_RUN=1

# Solo su Vercel: impedisce al runtime di parsare il body prima di noi.
# Serve a verificare l'HMAC dei webhook Shopify sui byte originali.
# Senza, la firma non corrisponde e i webhook vengono rifiutati.
NODEJS_HELPERS=0
